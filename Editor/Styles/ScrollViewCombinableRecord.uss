:root {
    --main-height: 40px;
    --texture-size: 40px;
    justify-content: center;
    margin-bottom: 8px;
}

#combinable-record__background {
    background-color: var(--bg-raised);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 10px;
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: var(--main-height);
    margin: 0 0 0 40px;
    padding: 0 6px 0 10px;
    transition-duration: 0.1s;
}

#combinable-record__background:hover {
    background-color: var(--bg-hover);
}

#combinable-record__icon-holder {
    width: var(--texture-size);
    height: var(--texture-size);
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 10px;
    border-width: 1px;
    border-color: var(--accent-border);
    background-color: var(--bg-base);
    -unity-background-scale-mode: scale-to-fit;
}

#combinable-record__item-name {
    -unity-text-align: middle-left;
    position: absolute;
    left: 10px;
    height: 100%;
    margin: 0;
    padding: 0;
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.combinable-record__button {
    margin: 0 0 0 6px;
    padding: 3px 10px;
    font-size: 12px;
}

#combinable-record__delete-button:hover {
    background-color: var(--danger-subtle);
    border-color: var(--danger);
    color: var(--danger);
}
