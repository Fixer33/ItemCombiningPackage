.combination-preview__background {
    background-color: var(--bg-raised);
    border-color: var(--border-subtle);
    border-width: 1px;
    border-radius: 10px;
    padding: 10px 14px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
    transition-duration: 0.1s;
}

.combination-preview__background:hover {
    background-color: var(--bg-hover);
}

.combination-preview__background #combination-preview__label-holder {
    flex-grow: 1;
    flex-shrink: 1;
}

.combination-preview__background #combination-preview__edit-btn {
    margin: 0 0 0 10px;
    padding: 4px 12px;
}

.combination-preview__background Label {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-left;
    white-space: normal;
}

.combination-preview__background #combination-preview__components-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--text-primary);
}

.combination-preview__background #combination-preview__results-label {
    font-size: 12px;
    color: var(--text-muted);
}

.combination-preview__background #combination-preview__divider {
    height: 1px;
    flex-grow: 0;
    background-color: var(--border-subtle);
    margin: 6px 0;
}
